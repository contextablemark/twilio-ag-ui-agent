# ==============================================
# Required Configuration
# ==============================================

# AG-UI backend that this server calls out to (REQUIRED)
AGUI_BACKEND_URL=https://your-agui-backend.example.com/chat
AGUI_BEARER_TOKEN=your-bearer-token

# ==============================================
# Deployment Configuration
# ==============================================

# For Railway: RAILWAY_PUBLIC_DOMAIN is set automatically - no config needed
# For local dev with ngrok: set your tunnel domain (no https://)
# NGROK_URL=your-ngrok-url.ngrok.io

# Server port (Railway sets PORT automatically)
PORT=8080

# ==============================================
# Optional Configuration
# ==============================================

# Voice Assistant Configuration
WELCOME_GREETING=Hi! I am an A I voice assistant powered by Twilio and AG-UI. Ask me anything!

# Conversation Mode
# STATEFUL=true   # Send full conversation history (default)
# STATEFUL=false  # Send only current message

# TTS Buffering (to prevent buffer underflows)
# MIN_CHUNK_SIZE=50  # Minimum characters before sending to TTS (default: 50)

# Logging
LOG_LEVEL=info
