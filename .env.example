# Twilio Configuration
NGROK_URL=your-ngrok-url.ngrok.io
PORT=8080

# Voice Assistant Configuration  
WELCOME_GREETING=Hi! I am an A I voice assistant powered by Twilio and AG-UI. Ask me anything!

# AG-UI Backend Configuration
AGUI_BACKEND_URL=http://localhost:3000/chat
# AGUI_API_KEY=your-agui-api-key

# Conversation Mode
# STATEFUL=true   # Send full conversation history (default)
# STATEFUL=false  # Send only current message

# Logging
LOG_LEVEL=info
